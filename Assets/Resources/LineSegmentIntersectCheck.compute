// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

RWStructuredBuffer<float4> links;
RWStructuredBuffer<int> hits;
int offset;
int total;

float Cross(float2 a, float2 b)
{
    return a.y * b.x - a.x * b.y;
}

bool FastIntersectCheck(float numerator, float denominator, float epsilon = 0.0001f)
{
    return denominator > 0 ?
        (numerator < -epsilon || numerator > denominator)
        : (numerator > epsilon || numerator < denominator);
}
bool ApproxEquals(float2 a, float2 b, float epsilon = 0.0001f)
{
    return length(a - b) < epsilon;
}

[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    int intercardIndex = (id.x / offset) + offset;
    int cardIndex = id.x % offset;

    float2 A = links[intercardIndex].xy;
    float2 B = links[intercardIndex].zw;
    float2 C = links[cardIndex].xy;
    float2 D = links[cardIndex].zw;

    float2 a = B - A;
    float2 b = C - D;
    float2 c = A - C;
    
    float alphaNumerator = Cross(b, c);
    float betaNumerator = Cross(c, a);
    float denominator = Cross(a, b);
    
    bool denomCheck = denominator < 0.0001f && denominator > -0.0001f;
    bool alphaRangeCheck = FastIntersectCheck(alphaNumerator, denominator);
    bool betaRangeCheck = FastIntersectCheck(betaNumerator, denominator);

    //The points were touching at the edges, so we should ignore the "collision".
    //We can always assume for our use case that lines that share end points shouldn't be culled.
    //Remove this if you want a collision detection algorithm that won't ignore lines that touch at endpoints
    bool touchedEdges = (ApproxEquals(A, C) || ApproxEquals(A, D) || ApproxEquals(B, C) || ApproxEquals(B, D));

    //If any of thense booleans are true, there was no intersection.
    bool noIntersect = (denomCheck || alphaRangeCheck || betaRangeCheck || touchedEdges);
    
    //Use interlocked add to prevent race conditions
    InterlockedAdd(hits[intercardIndex - offset], noIntersect ? 0 : 1);
}
