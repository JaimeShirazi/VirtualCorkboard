// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

RWStructuredBuffer<float4> links;
RWStructuredBuffer<int> hits;
int total;

float Cross(float2 a, float2 b)
{
    return a.y * b.x - a.x * b.y;
}

bool FastIntersectCheck(float numerator, float denominator, float epsilon = 0.0001f)
{
    return denominator > 0 ?
        (numerator < -epsilon || numerator > denominator)
        : (numerator > epsilon || numerator < denominator);
}
bool ApproxEquals(float2 a, float2 b, float epsilon = 0.0001f)
{
    return length(a - b) < epsilon;
}

int2 CalculateXY(int index)
{
    int X;

    int columnValuesSum = 0; //will sum the total pairs row-by-row
    //Iterate through the x axis
    for (X = 0; X < total; X++)
    {
        columnValuesSum += total - 1 - X; //Sum the amount of values in this column
        if (index < columnValuesSum) //If the index has was before the end of this column
        {
            break;
        }
    }

    //The Y can be found by getting the index and subtracting the amount of elements before the start of this column
    int Y = index - columnValuesSum + total;

    return int2(X, Y);
}

//We're still doing this using a 1-dimensional approach, using a set of calculations to transform this into X and Y coordinates on a triangular array.
//This triangular array consists of all the line segments mirrored on both axis, and ignores situations where X=Y as well.
//This is essentially an (n-1)x(n-1) triangular table where n is the total amount of line segments.
//The effect of this is that we will be doing comparisons for each of the line pairings only once.
[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    int2 indexes = CalculateXY(id.x);

    float2 A = links[indexes.x].xy;
    float2 B = links[indexes.x].zw;
    float2 C = links[indexes.y].xy;
    float2 D = links[indexes.y].zw;

    float2 a = B - A;
    float2 b = C - D;
    float2 c = A - C;
    
    float alphaNumerator = Cross(b, c);
    float betaNumerator = Cross(c, a);
    float denominator = Cross(a, b);
    
    bool denomCheck = denominator < 0.0001f && denominator > -0.0001f;
    bool alphaRangeCheck = FastIntersectCheck(alphaNumerator, denominator);
    bool betaRangeCheck = FastIntersectCheck(betaNumerator, denominator);
    
    bool zeroLengthCheck = (a.x == 0 && a.y == 0) || (b.x == 0 && b.y == 0);

    //If any of thense booleans are true, there was no intersection.
    bool noIntersect = (denomCheck || alphaRangeCheck || betaRangeCheck || zeroLengthCheck);
    
    int resultAddDelta = noIntersect ? 0 : 1;
    //Use interlocked add to prevent race conditions
    InterlockedAdd(hits[indexes.x], resultAddDelta);
    InterlockedAdd(hits[indexes.y], resultAddDelta);
}
